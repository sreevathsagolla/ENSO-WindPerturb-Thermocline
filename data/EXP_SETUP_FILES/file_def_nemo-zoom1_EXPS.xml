<?xml version="1.0"?>

<!--
     ============================================================================================================
=                                           output files definition                                        =
=                                            Define your own files for ocean dynamics context               =
=                                         put the variables you want...                                    =
============================================================================================================
-->

<file_definition type="one_file" compression_level="1" name="OUTPUT/@expname@_@freq@" sync_freq="1mo" min_digits="4">
  <file_group id="1d" output_freq="1d" split_freq="1mo" output_level="10" enabled=".TRUE.">
    <file id="file201" mode="write" writer="t1zwriter" gatherer="tgatherez" using_server2="true" name_suffix="_gridT_ENSO" description="zoom variables gridT_ENSO">
      <field field_ref="toce_con"  grid_ref="gridT3D_ENSO" name="toce_con" operation="average" freq_op="1d" > @toce_con_e3t / @e3t </field>
      <field field_ref="soce_abs"  grid_ref="gridT3D_ENSO" name="soce_abs" operation="average" freq_op="1d" > @soce_abs_e3t / @e3t </field>
      <field field_ref="e3t"       grid_ref="gridT3D_ENSO" name="e3t" operation="average"/>
      <field field_ref="ssh"       grid_ref="gridT2D_ENSO" name="ssh" operation="average"/>
      <field field_ref="botpres"   grid_ref="gridT2D_ENSO" name="botpres" operation="average"/>
      <field field_ref="qt"              grid_ref="gridT2D_ENSO" name="hfds"       standard_name="surface_downward_heat_flux_in_sea_water"  />
      <field field_ref="empmr"           grid_ref="gridT2D_ENSO" name="sowaflup"   standard_name="water_flux_out_of_sea_ice_and_sea_water"  />
      <field field_ref="saltflx"         grid_ref="gridT2D_ENSO" name="sosafldo"   standard_name="salt_flux_into_sea_water"                 />

<!-- trend diagnostics-->
      <field field_ref="ttrd_totad_li"   grid_ref="gridT3D_ENSO" name="ocontempadvect"  unit="W/m2"    />
      <field field_ref="ttrd_iso_li"     grid_ref="gridT3D_ENSO" name="ocontemppmdiff"  unit="W/m2"    />
      <field field_ref="ttrd_zdfp_li"    grid_ref="gridT3D_ENSO" name="ocontempdiff"    unit="W/m2"    />
      <field field_ref="ttrd_evd_li"     grid_ref="gridT3D_ENSO" name="ttrd_evd_li"                    />
      <field field_ref="ttrd_qns_li"     grid_ref="gridT2D_ENSO" name="ttrd_qns_li"                    />
      <field field_ref="ttrd_qsr_li"     grid_ref="gridT3D_ENSO" name="rsdoabsorb"      unit="W/m2"    />
      <field field_ref="ttrd_bbl_li"     grid_ref="gridT3D_ENSO" name="ttrd_bbl_li"                    />
      <field field_ref="ttrd_atf_li"     grid_ref="gridT3D_ENSO" name="ttrd_atf_li"                    />
      <field field_ref="ttrd_tot_li"     grid_ref="gridT3D_ENSO" name="ocontemptend"    unit="W/m2"    />
      <field field_ref="strd_totad_li"   grid_ref="gridT3D_ENSO" name="osaltadvect"     unit="Kg/m2/s" />
      <field field_ref="strd_iso_li"     grid_ref="gridT3D_ENSO" name="osaltpmdiff"     unit="kg/m2/s" />
      <field field_ref="strd_zdfp_li"    grid_ref="gridT3D_ENSO" name="osaltdiff"       unit="kg/m2/s" />
      <field field_ref="strd_evd_li"     grid_ref="gridT3D_ENSO" name="strd_evd_li"                    />
      <field field_ref="strd_tot_li"     grid_ref="gridT3D_ENSO" name="osalttend"       unit="kg/m2/s" />
      <field field_ref="strd_bbl_li"     grid_ref="gridT3D_ENSO" name="strd_bbl_li"                    />
      <field field_ref="strd_atf_li"     grid_ref="gridT3D_ENSO" name="strd_atf_li"                    />
    </file>

    <file id="file202" mode="write" writer="u1zwriter" gatherer="ugatherez" using_server2="true" name_suffix="_gridU_ENSO" description="zoom variables gridU_ENSO">
      <field field_ref="uoce"      grid_ref="gridU3D_ENSO"      name="uo"      operation="average" freq_op="1d" > @uoce_e3u / @e3u </field>
      <field field_ref="e3u"       grid_ref="gridU3D_ENSO"      name="e3u"     standard_name="cell_thickness" />
      <field field_ref="utau"      grid_ref="gridU2D_ENSO"      name="tauuo"   standard_name="surface_downward_x_stress"  />
    </file>

    <file id="file203" mode="write" writer="v1zwriter" gatherer="vgatherez" using_server2="true"  name_suffix="_gridV_ENSO" description="zoom variables gridV_ENSO">
      <field field_ref="voce"      grid_ref="gridV3D_ENSO"      name="vo"      operation="average" freq_op="1d" > @voce_e3v / @e3v </field>
      <field field_ref="e3v"       grid_ref="gridV3D_ENSO"      name="e3v"     standard_name="cell_thickness" />
      <field field_ref="vtau"      grid_ref="gridV2D_ENSO"      name="tauvo"   standard_name="surface_downward_y_stress"  />
    </file>

    <file id="file204" mode="write" writer="w1zwriter" gatherer="wgatherez" using_server2="true" name_suffix="_gridW_ENSO" description="zoom variables gridW_ENSO">
      <field field_ref="woce"      grid_ref="gridW3D_ENSO"      name="wo"      operation="average" />
      <field field_ref="e3w"       grid_ref="gridW3D_ENSO"      name="e3w"     standard_name="cell_thickness" />
      <field field_ref="bn2"       grid_ref="gridW3D_ENSO"      name="obvfsq"   />
    </file>
<!-- Need to allocate resource for writers and gatherers below in iodef.xml prior to use
-->
  </file_group>
</file_definition>
